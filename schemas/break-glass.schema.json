{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://acme.example/schemas/break-glass.schema.json",
  "title": "Break-glass activation (FE §11.8)",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "reason", "activatedBy", "activatedAt", "expiresAt", "paths"],
  "properties": {
    "id": { "type": "string", "pattern": "^BG-[0-9]{8}-[0-9]{2}$" },
    "reason": { "type": "string", "minLength": 10 },
    "activatedBy": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "string", "minLength": 1 } },
    "activatedAt": { "type": "string", "minLength": 20 },
    "expiresAt": { "type": "string", "minLength": 20 },
    "paths": { "type": "array", "minItems": 1, "items": { "type": "string" } }
  }
}
