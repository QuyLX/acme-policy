{
  "name": "@acme/presets",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Lint, TypeScript and test presets. The version used for verification is pinned in registry/kits.yaml (FE \u00a78.7 item 3, DV-05).",
  "exports": {
    "./eslint": {
      "types": "./eslint/index.d.mts",
      "default": "./eslint/index.mjs"
    },
    "./vitest": {
      "types": "./vitest/index.d.mts",
      "default": "./vitest/index.mjs"
    },
    "./tsconfig/*": "./tsconfig/*"
  },
  "dependencies": {
    "@nx/eslint-plugin": "24.0.6",
    "esbuild": "0.28.2",
    "eslint": "10.15.0",
    "eslint-config-next": "16.4.6",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "next": "16.4.6",
    "nx": "24.0.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.74.0"
  }
}
