+// Product catalogue for the marketplace page. Shared request options, cached for an hour.
+const CACHED = { next: { revalidate: 3600 } };
+
+export async function loadCatalog(baseUrl: string) {
+  const res = await fetch(`${baseUrl}/v1/catalog`, CACHED);
+  return res.json();
+}
