{
  "name": "{{name}}",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --port {{port}}",
    "build": "next build",
    "start": "next start --port {{port}}",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@platform/ds-icons": "workspace:*",
    "@platform/ds-react": "workspace:*",
    "@platform/ds-tokens": "workspace:*",
    "@platform/i18n": "workspace:*",
    "@platform/server": "workspace:*",
    "next": "16.4.6",
    "next-intl": "4.16.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "10.15.0",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "vitest": "{{vitestVersion}}"
  },
  "nx": { "tags": ["scope:{{name}}", "type:app"] },
  "factory": { "generatedFrom": "app@{{generatorVersion}}" }
}
