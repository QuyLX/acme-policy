+// Warms the next page of the audit log while the user reads the current one.
+type QueryClient = {
+  prefetchQuery(options: { queryKey: readonly unknown[]; queryFn: () => Promise<unknown> }): Promise<void>;
+};
+
+export async function prefetchAuditPage(client: QueryClient, page: number, load: (page: number) => Promise<unknown>) {
+  await client.prefetchQuery({ queryKey: ['audit-log', { page: page + 1 }], queryFn: () => load(page + 1) });
+}
