+// Open/paid invoice list for the billing page (synthetic data only).
+declare function useSuspenseQuery<T>(options: { queryKey: readonly unknown[]; queryFn: () => Promise<T> }): { data: T };
+
+export type InvoiceFilter = { status: 'open' | 'paid'; page: number };
+
+export function useInvoices(filter: InvoiceFilter, load: (f: InvoiceFilter) => Promise<unknown[]>) {
+  return useSuspenseQuery({
+    queryKey: ['invoices', filter.status, filter.page],
+    queryFn: () => load(filter),
+  });
+}
