+// Builds the tenant export for spreadsheet tools that expect semicolon-separated values.
+import type { TenantRow } from './data.ts';
+
+export function tenantSheet(rows: TenantRow[]): string {
+  const header = ['id', 'name', 'status', 'balance'].join(';');
+  const body = rows.map((t) => [t.id, t.name, t.status, t.balance.toFixed(2)].join(';'));
+  return [header, ...body].join('\n');
+}
