{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://acme.example/schemas/check-result.schema.json",
  "title": "CheckResult (Standard Appendix K.2)",
  "type": "object",
  "required": ["checkId", "checkVersion", "requiredBy", "requirement", "enforcement", "severity", "gate", "status", "command", "durationMs", "attempts", "evidence"],
  "properties": {
    "checkId": { "type": "string", "pattern": "^[a-z0-9-]+(\\.[a-z0-9-]+)+$" },
    "checkVersion": { "type": "string" },
    "implementsRules": { "type": "array", "items": { "type": "string" } },
    "requiredBy": { "type": "array", "items": { "type": "string" } },
    "requirement": { "enum": ["required", "advisory"] },
    "enforcement": { "enum": ["observe", "warn", "blocking"] },
    "severity": { "enum": ["BLOCKER", "WARNING", "INFO"] },
    "gate": { "enum": ["merge", "publish", "post-release"] },
    "status": { "enum": ["PASS", "FAIL", "ERROR", "NOT_ASSESSED"] },
    "reason": { "type": "string", "minLength": 1 },
    "disposition": {
      "description": "Standard Appendix K.2 Disposition (closed set, Standard §7.5 item 7)",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "decidedBy", "decidedAt"],
      "properties": {
        "type": { "enum": ["not-applicable", "assessed-elsewhere", "baselined", "waived", "deferred"] },
        "decidedBy": { "type": "string", "description": "\"policy\" or a HumanRef" },
        "decidedAt": { "type": "string" },
        "policyRef": { "type": "string" },
        "waiverId": { "type": "string" },
        "baselineRef": { "type": "string" },
        "assessedElsewhere": {
          "type": "object",
          "additionalProperties": false,
          "required": ["runId", "providerVersion", "validUntil"],
          "properties": { "runId": { "type": "string" }, "providerVersion": { "type": "string" }, "validUntil": { "type": "string" } }
        },
        "deferredTo": { "enum": ["merge", "publish", "post-release"] }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "enum": ["not-applicable", "assessed-elsewhere", "baselined"] } } },
          "then": { "properties": { "decidedBy": { "const": "policy" } }, "required": ["policyRef"] }
        },
        { "if": { "properties": { "type": { "const": "assessed-elsewhere" } } }, "then": { "required": ["assessedElsewhere"] } },
        { "if": { "properties": { "type": { "const": "waived" } } }, "then": { "required": ["waiverId"] } },
        { "if": { "properties": { "type": { "const": "deferred" } } }, "then": { "required": ["deferredTo"] } }
      ]
    },
    "command": { "type": "string" },
    "durationMs": { "type": "integer", "minimum": 0 },
    "attempts": { "type": "integer", "minimum": 1 },
    "tool": { "type": "object" },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source", "severity", "message", "state"],
        "properties": {
          "source": { "enum": ["check", "ai-review", "security-review", "integrity"] },
          "ruleId": { "type": "string" },
          "severity": { "type": "string" },
          "location": { "type": "string" },
          "message": { "type": "string" },
          "state": { "enum": ["open", "fixed", "dismissed"] }
        }
      }
    },
    "evidence": { "type": "array" },
    "extensions": { "type": "object", "propertyNames": { "pattern": "^x-" } }
  },
  "if": { "properties": { "status": { "not": { "const": "PASS" } } } },
  "then": { "required": ["reason"] }
}
