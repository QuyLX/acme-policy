import { Badge, EmptyState } from '@platform/ds-react';
import { getTranslations } from 'next-intl/server';
import { getRequestContext } from '../server/context';

/** Health page of a generated app: proves DS, tokens, i18n and the server context are wired. */
export default async function HomePage() {
  const t = await getTranslations('home');
  const ctx = await getRequestContext();
  return (
    <main className="mx-auto flex min-h-screen max-w-3xl flex-col gap-6 p-8">
      <h1 className="text-2xl font-semibold">{t('title')}</h1>
      <Badge tone="success">{t('status')}</Badge>
      <EmptyState title={t('emptyTitle')} description={t('emptyDescription', { tenant: ctx.tenantId })} />
    </main>
  );
}
