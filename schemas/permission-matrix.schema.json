{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://acme.invalid/schemas/permission-matrix.schema.json",
  "title": "PermissionMatrix — permissions.yaml per app (FE-PERM-001; FE §8.4 authz.permission-matrix, authz.negative; tech-design 13 §5)",
  "description": "roles is the IAM stand-in while no IdP is chosen (D-03 open): persona → permissions. A persona with no permissions is a valid session that is forbidden, not unauthenticated. Entry paths are relative to the directory of permissions.yaml.",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "app", "roles", "entries"],
  "properties": {
    "apiVersion": { "const": "aisf/4.0" },
    "kind": { "const": "PermissionMatrix" },
    "app": { "type": "string", "minLength": 1 },
    "roles": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[a-zA-Z][a-zA-Z0-9-]*$" },
      "additionalProperties": { "type": "array", "items": { "$ref": "#/$defs/permission" }, "uniqueItems": true }
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "path", "permission", "allow", "deny"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*$" },
          "kind": { "enum": ["page", "action", "route"] },
          "path": { "type": "string", "pattern": "^[^/].*\\.(ts|tsx|mts|js|jsx|mjs)$" },
          "permission": { "$ref": "#/$defs/permission" },
          "allow": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "deny": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
        }
      }
    }
  },
  "$defs": {
    "permission": { "type": "string", "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+$" }
  }
}
