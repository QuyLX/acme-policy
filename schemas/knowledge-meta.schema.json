{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://acme.example/schemas/knowledge-meta.schema.json",
  "title": "Knowledge artifact frontmatter (Standard Appendix K.5, Appendix E)",
  "type": "object",
  "required": [
    "id",
    "kind",
    "status",
    "version",
    "owner",
    "authority"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9]*(-[A-Z0-9]+)+$"
    },
    "kind": {
      "enum": [
        "spec",
        "design",
        "adr",
        "proposal",
        "living-doc",
        "runbook",
        "agent-guide",
        "skill",
        "playbook",
        "component",
        "threat-model",
        "policy"
      ],
      "description": "Standard KnowledgeKind plus kinds registered by aisf-frontend@1.1.0 (FE §18: component, threat-model, policy)."
    },
    "status": {
      "enum": [
        "DRAFT",
        "PROPOSED",
        "ACTIVE",
        "NEEDS_REVALIDATION",
        "SUPERSEDED",
        "DEPRECATED",
        "ARCHIVED"
      ]
    },
    "version": {
      "type": "string"
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "authority": {
      "enum": [
        "intent",
        "decision",
        "implementation-description",
        "procedure",
        "guidance"
      ]
    },
    "describes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "basedOn": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^.+@.+$"
      }
    },
    "generatedFrom": {
      "type": "string"
    },
    "supersedes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "supersededBy": {
      "type": "string"
    },
    "validatedAgainst": {
      "type": "object"
    },
    "reviewTriggers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "deprecationReason": {
      "type": "string"
    },
    "x-fe": {
      "type": "object",
      "additionalProperties": false,
      "description": "aisf-frontend@1.1.0 profile fields (FE §7.3): where the record applies and who may read it through the Knowledge Index (FE §7.8)",
      "properties": {
        "appliesTo": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "repos": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "surfaces": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "packages": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              },
              "description": "package name → version range, e.g. \"@platform/server\": \">=3 <4\""
            },
            "contracts": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              },
              "description": "contract id → version or range"
            }
          }
        },
        "visibility": {
          "enum": [
            "public",
            "internal",
            "restricted"
          ]
        },
        "readers": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Access list inherited from the source (identities or groups); required to read a restricted record"
        },
        "indexOptIn": {
          "type": "boolean",
          "description": "Owner's explicit opt-in to index a restricted record (FE §7.8 rule 1); without it the record is never indexed"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "SUPERSEDED"
          }
        }
      },
      "then": {
        "required": [
          "supersededBy"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "DEPRECATED"
          }
        }
      },
      "then": {
        "required": [
          "deprecationReason"
        ]
      }
    }
  ]
}
