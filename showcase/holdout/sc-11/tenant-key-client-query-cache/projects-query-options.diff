+// Shared query definition for the project switcher, reused by the sidebar and the settings page.
+declare function queryOptions<T>(options: { queryKey: readonly unknown[]; queryFn: () => Promise<T>; staleTime?: number }): unknown;
+
+export const projectsQuery = (load: () => Promise<{ id: string; name: string }[]>) =>
+  queryOptions({
+    queryKey: ['projects', 'list'] as const,
+    queryFn: load,
+    staleTime: 60_000,
+  });
