{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://acme.invalid/schemas/trusted-mechanism.schema.json",
  "title": "TrustedMechanismRegistry (Standard §7.13 items 31, 36, 37; §8.7 rule 7)",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "mechanisms"],
  "properties": {
    "apiVersion": { "const": "aisf/4.0" },
    "kind": { "const": "TrustedMechanismRegistry" },
    "mechanisms": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "owner", "produces", "direction", "description", "runsOn"],
        "properties": {
          "id": { "type": "string", "pattern": "^trusted:[a-z0-9-]+$" },
          "owner": { "type": "string", "minLength": 1 },
          "produces": { "type": "string" },
          "direction": { "enum": ["tightening", "neutral"] },
          "description": { "type": "string" },
          "runsOn": {
            "type": "object",
            "additionalProperties": false,
            "required": ["executor", "event", "ref"],
            "properties": {
              "executor": { "const": "ci" },
              "event": { "enum": ["push", "schedule", "workflow_dispatch"] },
              "ref": { "type": "string", "pattern": "^refs/heads/" }
            }
          }
        }
      }
    }
  }
}
