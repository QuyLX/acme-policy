+// Server-side pricing lookup; revalidated every five minutes.
+export async function loadPricing(baseUrl: string) {
+  const res = await fetch(`${baseUrl}/v1/pricing`, { next: { revalidate: 300, tags: ['pricing'] } });
+  if (!res.ok) throw new Error(`pricing ${res.status}`);
+  return res.json();
+}
