{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://acme.invalid/schemas/profile-layer.schema.json",
  "title": "ProfileLayer — one layer of the verification profile resolution (Standard §7.3 items 10-16; FE §8.3, Appendix A)",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "layer", "id", "version", "owner", "checks"],
  "properties": {
    "apiVersion": { "const": "aisf/4.0" },
    "kind": { "const": "ProfileLayer" },
    "layer": { "enum": ["core", "domain", "organization", "repository", "surface", "task-class", "risk", "task"] },
    "id": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "owner": { "type": "string", "minLength": 1, "description": "Owner of the profile: decides conflicts with other profiles (Standard §7.3 item 15)" },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+(\\.[a-z0-9-]+)+$" },
          "requirement": { "enum": ["required", "advisory", "optional"] },
          "when": { "type": "string" },
          "gate": { "enum": ["merge", "publish", "post-release"] },
          "params": {
            "type": "object",
            "description": "Parameter forms: {exact} incomparable when different; {min} higher is stricter; {max} lower is stricter; {set} union. A plain scalar is exact, a plain array is a set.",
            "additionalProperties": {
              "oneOf": [
                { "type": "string" },
                { "type": "number" },
                { "type": "boolean" },
                { "type": "array" },
                { "type": "object", "additionalProperties": false, "required": ["exact"], "properties": { "exact": {} } },
                { "type": "object", "additionalProperties": false, "required": ["min"], "properties": { "min": { "type": "number" } } },
                { "type": "object", "additionalProperties": false, "required": ["max"], "properties": { "max": { "type": "number" } } },
                { "type": "object", "additionalProperties": false, "required": ["set"], "properties": { "set": { "type": "array" } } }
              ]
            }
          }
        }
      }
    },
    "resolutions": {
      "type": "array",
      "description": "Versioned resolution entries for incomparable conflicts, recorded in the more specific profile (Standard §7.3 item 15)",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["checkId", "parameter", "value", "decisionRef", "decidedBy", "decidedAt"],
        "properties": {
          "checkId": { "type": "string" },
          "parameter": { "type": "string" },
          "value": {},
          "decisionRef": { "type": "string", "description": "Resolution entry id or ADR" },
          "decidedBy": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
          "decidedAt": { "type": "string" }
        }
      }
    }
  }
}
