+// Quota limits rarely change, so the response is kept in the data cache.
+export async function loadQuotas(baseUrl: string, token: string) {
+  const res = await fetch(baseUrl + '/v1/quotas', {
+    headers: { authorization: `Bearer ${token}` },
+    cache: 'force-cache',
+  });
+  return res.json();
+}
