+++ b/apps/admin/src/app/tenants/audit-export/route.ts
@@ -0,0 +1,15 @@
+// Route: CSV download of tenant status changes (added after export.csv-injection was activated).
+import { ForbiddenError, requirePermission } from '../../../platform/authz.ts';
+import { requestContext } from '../../../platform/session.ts';
+import { allTenants } from '../../../domains/tenants/server/data.ts';
+
+export async function GET(): Promise<Response> {
+  try {
+    requirePermission(await requestContext(), 'tenants.export');
+  } catch (err) {
+    if (err instanceof ForbiddenError) return new Response(null, { status: 403 });
+    throw err;
+  }
+  const lines = allTenants().map((t) => `${t.id},${t.name},${t.status}`);
+  return new Response(`tenant,name,status\r\n${lines.join('\r\n')}\r\n`, { headers: { 'content-type': 'text/csv' } });
+}
